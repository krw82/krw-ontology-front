{
  "name": "krw-ontology-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-worker.mjs",
    "dev:web": "next dev",
    "dev:worker": "npm run build:worker && node scripts/start-worker.mjs",
    "dev:runtime": "scripts/deploy-dev-runtime.sh",
    "dev:release": "scripts/deploy-dev-data-release.sh",
    "dev:release:publish": "scripts/deploy-dev-data-release.sh",
    "dev:catalog": "scripts/deploy-dev-data-release.sh",
    "dev:data": "scripts/deploy-dev-data-release.sh",
    "build": "next build && npm run build:worker",
    "build:worker": "esbuild src/worker/agent-worker.ts --bundle --platform=node --target=node20 --format=esm --packages=external --alias:server-only=./src/worker/server-only-shim.ts --outfile=.worker/agent-worker.mjs",
    "start": "node .next/standalone/server.js",
    "start:worker": "node .worker/agent-worker.mjs",
    "worker:mac:init-env": "scripts/init-mac-worker-env.sh",
    "worker:mac:preflight": "scripts/mac-worker-preflight.sh",
    "worker:mac:start": "scripts/start-mac-worker-production.sh",
    "worker:mac:launchd:install": "scripts/install-mac-worker-launchd.sh",
    "worker:mac:launchd:uninstall": "scripts/uninstall-mac-worker-launchd.sh",
    "worker:prod:status": "scripts/status-production-workers.sh",
    "worker:prod:stop-gcp": "scripts/stop-gcp-agent-worker.sh",
    "worker:prod:start-gcp": "scripts/start-gcp-agent-worker.sh",
    "mcp:prod:start": "scripts/start-mcp-server-production.sh",
    "mcp:prod:verify": "scripts/verify-mcp-server-production.sh",
    "mcp:prod:status": "scripts/verify-mcp-server-production.sh",
    "mcp:prod:logs": "scripts/tail-mcp-logs.sh prod",
    "mcp:prod:launchd:install": "scripts/install-mcp-server-launchd.sh",
    "mcp:prod:launchd:uninstall": "scripts/uninstall-mcp-server-launchd.sh",
    "mcp:dev:start": "scripts/start-mcp-server-dev.sh",
    "mcp:dev:verify": "scripts/verify-mcp-server-dev.sh",
    "mcp:dev:status": "scripts/verify-mcp-server-dev.sh",
    "mcp:dev:logs": "scripts/tail-mcp-logs.sh dev",
    "mcp:dev:launchd:install": "scripts/install-mcp-server-dev-launchd.sh",
    "mcp:dev:launchd:uninstall": "scripts/uninstall-mcp-server-dev-launchd.sh",
    "stock-news:prod:start": "scripts/start-stock-news-mcp-production.sh",
    "stock-news:prod:verify": "scripts/verify-stock-news-mcp-production.sh",
    "stock-news:prod:status": "scripts/verify-stock-news-mcp-production.sh",
    "stock-news:prod:launchd:install": "scripts/install-stock-news-mcp-launchd.sh",
    "stock-news:prod:launchd:uninstall": "scripts/uninstall-stock-news-mcp-launchd.sh",
    "stock-news:dev:start": "scripts/start-stock-news-mcp-dev.sh",
    "stock-news:dev:verify": "scripts/verify-stock-news-mcp-dev.sh",
    "stock-news:dev:status": "scripts/verify-stock-news-mcp-dev.sh",
    "stock-news:coverage:export": "node scripts/export-stock-news-coverage.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "docker:build:mcp": "docker build --build-context krw-ontology-src=${KRW_ONTOLOGY_SOURCE_DIR:-../krw-ontology} -f Dockerfile.mcp .",
    "prod:status": "npm run mcp:prod:status && npm run worker:prod:status",
    "prod:deploy:dry": "scripts/deploy-production.sh --dry-run",
    "prod:deploy:web": "scripts/deploy-web-production.sh",
    "prod:deploy:runtime": "scripts/deploy-plugin-worker-production.sh",
    "prod:deploy:code": "scripts/deploy-production.sh",
    "prod:deploy:full": "scripts/deploy-all-production.sh --apply-migrations",
    "prod:deploy:safe": "scripts/deploy-with-queue-pause.sh",
    "prod:release:publish": "scripts/deploy-data-release-production.sh",
    "legacy:gcp-mcp": "scripts/deploy-plugin-production.sh",
    "legacy:data-gcp": "scripts/deploy-data-production.sh",
    "deploy:prod": "scripts/deploy-production.sh",
    "deploy:prod:dry": "scripts/deploy-production.sh --dry-run",
    "deploy:prod:code": "scripts/deploy-production.sh",
    "deploy:prod:full": "scripts/deploy-all-production.sh --apply-migrations",
    "deploy:all": "scripts/deploy-all-production.sh",
    "deploy:data": "scripts/deploy-data-release-production.sh",
    "deploy:web": "scripts/deploy-web-production.sh",
    "deploy:worker": "scripts/deploy-worker-production.sh",
    "deploy:runtime": "scripts/deploy-plugin-worker-production.sh",
    "deploy:runtime:prod": "scripts/deploy-plugin-worker-production.sh",
    "deploy:runtime:dev": "scripts/deploy-dev-runtime.sh",
    "deploy:plugin": "scripts/deploy-plugin-worker-production.sh",
    "deploy:mcp": "scripts/deploy-plugin-worker-production.sh",
    "deploy:plugin:gcp": "scripts/deploy-plugin-production.sh",
    "deploy:legacy:gcp-mcp": "scripts/deploy-plugin-production.sh",
    "deploy:legacy:data-gcp": "scripts/deploy-data-production.sh",
    "publish:web-catalog": "node scripts/publish-web-catalog.mjs",
    "verify:web-catalog": "node scripts/verify-web-catalog-release.mjs",
    "deploy:safe": "scripts/deploy-with-queue-pause.sh",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --grep \"public pages\"",
    "test:e2e:auth": "playwright test --grep \"dev auth bypass\"",
    "test:e2e:api": "playwright test --grep \"protected API\"",
    "test:e2e:reuse": "PLAYWRIGHT_REUSE_SERVER=1 playwright test",
    "test:e2e:prod-chat": "node scripts/run-prod-chat-e2e.mjs",
    "verify:sdk-freeze": "node scripts/verify-sdk-freeze.mjs",
    "supabase:login": "scripts/supabase-cli.sh login",
    "supabase:orgs": "scripts/supabase-cli.sh orgs list",
    "supabase:projects": "scripts/supabase-cli.sh projects list",
    "supabase:link": "scripts/supabase-cli.sh link",
    "supabase:db:push:dry": "scripts/supabase-cli.sh db push --dry-run",
    "supabase:db:push": "scripts/supabase-cli.sh db push",
    "supabase:schema:smoke": "node scripts/supabase-schema-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.40",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
