{
  "name": "krw-ontology-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "docker:build:mcp": "docker build --build-context krw-ontology-src=${KRW_ONTOLOGY_SOURCE_DIR:-../krw-ontology} -f Dockerfile.mcp .",
    "deploy:prod": "scripts/deploy-production.sh",
    "deploy:prod:dry": "scripts/deploy-production.sh --dry-run",
    "deploy:all": "scripts/deploy-all-production.sh",
    "deploy:data": "scripts/deploy-data-production.sh",
    "deploy:web": "scripts/deploy-web-production.sh",
    "deploy:plugin": "scripts/deploy-plugin-production.sh",
    "deploy:safe": "scripts/deploy-with-queue-pause.sh",
    "lint": "eslint",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:public": "playwright test --grep \"public pages\"",
    "test:e2e:auth": "playwright test --grep \"dev auth bypass\"",
    "test:e2e:api": "playwright test --grep \"protected API\"",
    "test:e2e:reuse": "PLAYWRIGHT_REUSE_SERVER=1 playwright test",
    "verify:sdk-freeze": "node scripts/verify-sdk-freeze.mjs",
    "supabase:login": "npx supabase login",
    "supabase:orgs": "npx supabase orgs list",
    "supabase:projects": "npx supabase projects list",
    "supabase:link": "npx supabase link",
    "supabase:db:push:dry": "npx supabase db push --dry-run",
    "supabase:db:push": "npx supabase db push",
    "supabase:schema:smoke": "node scripts/supabase-schema-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.40",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "postcss": "8.5.14"
  }
}
