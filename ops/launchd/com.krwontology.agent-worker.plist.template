<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>WorkingDirectory</key>
  <string>__FRONT_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__FRONT_DIR__/scripts/start-mac-worker-production.sh</string>
    <string>--env-file</string>
    <string>__ENV_FILE__</string>
    <string>--worker-id</string>
    <string>__WORKER_ID__</string>
    <string>--log-file</string>
    <string>__FRONT_DIR__/logs/mac-agent-worker-__WORKER_ID__.log</string>
    <string>--no-build</string>
    <string>--skip-preflight</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>Nice</key>
  <integer>__NICE__</integer>

  <key>StandardOutPath</key>
  <string>__FRONT_DIR__/logs/launchd-agent-worker-__WORKER_ID__.out.log</string>

  <key>StandardErrorPath</key>
  <string>__FRONT_DIR__/logs/launchd-agent-worker-__WORKER_ID__.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
</dict>
</plist>
