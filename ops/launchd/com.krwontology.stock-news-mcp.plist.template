<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.krwontology.stock-news-mcp</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/nice</string>
    <string>-n</string>
    <string>__NICE__</string>
    <string>__FRONT_DIR__/scripts/start-stock-news-mcp-production.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__FRONT_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>__MAXFILES__</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/stock-news-mcp-prod.out.log</string>

  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/stock-news-mcp-prod.err.log</string>
</dict>
</plist>
