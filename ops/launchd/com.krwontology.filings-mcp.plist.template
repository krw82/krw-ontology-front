<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.krwontology.filings-mcp</string>

  <key>WorkingDirectory</key>
  <string>__FRONT_DIR__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>__FRONT_DIR__/scripts/start-filings-mcp-production.sh</string>
    <string>--env-file</string>
    <string>__ENV_FILE__</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>Nice</key>
  <integer>__NICE__</integer>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/filings-mcp-prod.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/filings-mcp-prod.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
</dict>
</plist>
