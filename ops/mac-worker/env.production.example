# Copy to ~/krw-ontology-front/.env.mac-worker.production
# or generate it with:
#   scripts/init-mac-worker-env.sh
#
# Five isolated worker processes are supported through launchd. Keep
# GLOBAL_CONCURRENT_RUN_LIMIT at least MAC_WORKER_COUNT so every worker can
# claim one run.

NODE_ENV=production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
DEEPSEEK_API_KEY=

KRW_ONTOLOGY_ENV=prod
KRW_ONTOLOGY_RELEASE_ROOT=~/krw-ontology-data/releases/prod/current
KRW_ONTOLOGY_ROOT=~/krw-ontology-data/releases/prod/current
KRW_ONTOLOGY_MANIFEST_PATH=~/krw-ontology-data/releases/prod/current/manifest.json
KRW_ONTOLOGY_INDEX_PATH=~/krw-ontology-data/releases/prod/current/indexes/agent_index.sqlite
KRW_ONTOLOGY_SOURCE_DIR=~/krw-ontology
KRW_ONTOLOGY_PLUGIN_SOURCE_PATH=~/krw-ontology/plugins/krw-ontology
KRW_ONTOLOGY_PLUGIN_PATH=~/krw-ontology-front/ref/plugins/prod/krw-ontology
KRW_ONTOLOGY_MCP_HOST=127.0.0.1
KRW_ONTOLOGY_MCP_PORT=8765
KRW_ONTOLOGY_MCP_PATH=/mcp
KRW_ONTOLOGY_MCP_URL=http://127.0.0.1:8765/mcp
KRW_ONTOLOGY_MCP_HEALTH_URL=http://127.0.0.1:8765/health
CLAUDE_AGENT_CWD=~/krw-ontology-front/.agent-workspace
CLAUDE_CONFIG_DIR=~/.claude-krw
CLAUDE_CODE_EXECUTABLE=~/.local/bin/claude-krw
EXPECTED_CLAUDE_CODE_VERSION=2.1.111

AGENT_WORKER_ID_PREFIX=mac-worker-jwc
MAC_WORKER_COUNT=5
MAC_WORKER_NICE=-5
MCP_SERVER_NICE=-5
MCP_SERVER_LOG_LEVEL=warning
AGENT_WORKER_ID=mac-worker-jwc-1
GLOBAL_CONCURRENT_RUN_LIMIT=5
AGENT_WORKER_POLL_INTERVAL_MS=1000
AGENT_WORKER_IDLE_LOG_INTERVAL_MS=60000

CLAUDE_MODEL=sonnet
CLAUDE_AGENT_MAX_TURNS=20
AGENT_MAX_TOOL_CALLS=32
AGENT_RUN_HARD_TIMEOUT_MINUTES=6
LEASE_TIMEOUT_MINUTES=10
LEASE_HEARTBEAT_INTERVAL_MS=30000
MCP_HEALTH_TIMEOUT_MS=30000
KRW_SQLITE_READ_CACHE_MIB=512
KRW_SQLITE_READ_MMAP_MIB=2048
