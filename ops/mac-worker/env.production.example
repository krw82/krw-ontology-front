# Copy to ~/krw-ontology-front/.env.mac-worker.production
# or generate it with:
#   scripts/init-mac-worker-env.sh
#
# One launchd supervisor process owns production execution. It wakes from
# Postgres LISTEN/NOTIFY and uses an internal concurrency pool.

NODE_ENV=production

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
AGENT_QUEUE_LISTEN_DATABASE_URL=
AGENT_RUN_CANCEL_LISTEN_DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
DEEPSEEK_API_KEY=
FINNHUB_API_KEY=
ZAI_API_KEY=

KRW_ONTOLOGY_ENV=prod
KRW_ONTOLOGY_RELEASE_ROOT=~/krw-ontology-data/releases/prod/current
KRW_ONTOLOGY_ROOT=~/krw-ontology-data/releases/prod/current
KRW_ONTOLOGY_MANIFEST_PATH=~/krw-ontology-data/releases/prod/current/manifest.json
KRW_ONTOLOGY_GLOBAL_SPINE_PATH=~/krw-ontology-data/releases/prod/current/indexes/global_spine.sqlite
KRW_ONTOLOGY_SHARD_MANIFEST_PATH=~/krw-ontology-data/releases/prod/current/indexes/shard_manifest.json
KRW_ONTOLOGY_SOURCE_DIR=~/krw-ontology
KRW_ONTOLOGY_PLUGIN_SOURCE_PATH=~/krw-ontology/plugins/krw-ontology
KRW_ONTOLOGY_PLUGIN_PATH=~/krw-ontology-front/ref/plugins/prod/krw-ontology
KRW_GURU_ADVISOR_PLUGIN_SOURCE_PATH=~/krw-ontology/plugins/krw-guru-advisor
KRW_GURU_ADVISOR_PLUGIN_PATH=~/krw-ontology-front/ref/plugins/prod/krw-guru-advisor
KRW_GURU_DATA_ROOT=~/krw-ontology-guru-data
KRW_GURU_RELEASE_ROOT=~/krw-ontology-guru-data/releases/prod/current
# Keep the legacy bridge until the feature-enabled path is explicitly promoted.
GURU_AGENT_GENERATED_BRIEF_ENABLED=1
KRW_ONTOLOGY_MCP_HOST=127.0.0.1
KRW_ONTOLOGY_MCP_PORT=8765
KRW_ONTOLOGY_MCP_PATH=/mcp
KRW_ONTOLOGY_MCP_URL=http://127.0.0.1:8765/mcp
KRW_ONTOLOGY_MCP_HEALTH_URL=http://127.0.0.1:8765/health
KRW_ONTOLOGY_MCP_READY_URL=http://127.0.0.1:8765/readyz
DESKTOP_ONTOLOGY_EXECUTOR=mcp
DESKTOP_ONTOLOGY_MAX_RESULT_BYTES=180000
KRW_MCP_EXPECTED_CONTRACT_VERSION=krw-ontology-mcp/v2
KRW_MCP_EXPECTED_BUILD_ID=
KRW_MCP_EXPECTED_BACKEND_GIT_SHA=
KRW_MCP_EXPECTED_TOOL_SCHEMA_SHA256=
KRW_MCP_EXPECTED_BUILD_FINGERPRINT_SHA256=
KRW_MCP_EXPECTED_RELEASE_MANIFEST_SHA256=
KRW_MCP_EXPECTED_SERVICE_FINGERPRINT_SHA256=
CLAUDE_AGENT_CWD=~/krw-ontology-front/.agent-workspace
CLAUDE_CONFIG_DIR=~/.claude-krw
CLAUDE_CODE_EXECUTABLE=~/.local/bin/claude-krw
EXPECTED_CLAUDE_CODE_VERSION=2.1.204

AGENT_SUPERVISOR_ID=mac-supervisor-jwc
AGENT_SUPERVISOR_CONCURRENCY=8
AGENT_WORKER_ID_PREFIX=mac-worker-jwc
MAC_WORKER_COUNT=8
MAC_WORKER_NICE=-5
MCP_SERVER_NICE=-5
KRW_LOG_DIR=~/krw-ontology-log
MCP_SERVER_LOG_LEVEL=info
KRW_MCP_HTTP_LOG_LEVEL=warning
KRW_MCP_PROTOCOL_LOG_LEVEL=warning
KRW_MCP_LOG_MAX_BYTES=10485760
KRW_MCP_LOG_BACKUP_COUNT=3
MCP_LOG_DIR=~/krw-ontology-log/mcp/prod
KRW_DEPLOY_LOG_DIR=~/krw-ontology-log/deploy
MCP_SERVER_MAXFILES=4096
KRW_MCP_STORE_MODE=persistent
KRW_MCP_STORE_POOL_MAX=8
AGENT_WORKER_ID=mac-supervisor-jwc
GLOBAL_CONCURRENT_RUN_LIMIT=8
AGENT_QUEUE_LISTEN_ENABLED=1
AGENT_QUEUE_LISTEN_CHANNEL=agent_run_queued
AGENT_QUEUE_RECONCILE_INTERVAL_MS=60000
AGENT_QUEUE_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_RUN_CANCEL_LISTEN_ENABLED=1
AGENT_RUN_CANCEL_LISTEN_CHANNEL=agent_run_cancel
AGENT_RUN_CANCEL_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_RUN_CANCEL_RECONCILE_INTERVAL_MS=10000
AGENT_SUPERVISOR_SHUTDOWN_GRACE_MS=120000
AGENT_WORKER_IDLE_LOG_INTERVAL_MS=60000

CLAUDE_MODEL=sonnet
CLAUDE_AGENT_MAX_TURNS=40
AGENT_MAX_TOOL_CALLS=32
YAHOO_FINANCE_MAX_CALLS=4
# Enable only after a production canary validates the grounded-answer contract.
RESEARCH_ANSWER_ENVELOPE_ENABLED=0
# Valid values: off, shadow, on. "shadow" compiles visuals without publishing
# them; use "on" only after the production canary is approved.
KRW_CHART_SERIES_ENABLED=0
STOCK_NEWS_MCP_ROOT=~/mcp-servers/stock-news-mcp
STOCK_NEWS_MCP_HOST=127.0.0.1
STOCK_NEWS_MCP_PORT=8775
STOCK_NEWS_MCP_PATH=/mcp
STOCK_NEWS_MCP_URL=http://127.0.0.1:8775/mcp
STOCK_NEWS_FORCE_DISABLED=1
STOCK_NEWS_MAX_CALLS=12
AGENT_RUN_HARD_TIMEOUT_MINUTES=10
LEASE_TIMEOUT_MINUTES=10
LEASE_HEARTBEAT_INTERVAL_MS=30000
MCP_HEALTH_TIMEOUT_MS=30000
KRW_SQLITE_READ_CACHE_MIB=512
KRW_SQLITE_READ_MMAP_MIB=2048
