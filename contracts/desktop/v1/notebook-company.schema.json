{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krwontology.com/contracts/desktop/v1/notebook-company.schema.json",
  "title": "KRW Desktop Notebook Company v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "contract_version", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "contract_version": { "const": "desktop-notebook-company/v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company",
        "notebook",
        "questions",
        "notes",
        "card",
        "theses",
        "thesis_checks"
      ],
      "properties": {
        "company": {
          "$ref": "notebook-overview.schema.json#/$defs/company"
        },
        "notebook": { "type": "object" },
        "questions": { "type": "array", "items": { "type": "object" } },
        "notes": { "type": "array", "items": { "type": "object" } },
        "card": { "type": ["object", "null"] },
        "theses": { "type": "array", "items": { "type": "object" } },
        "thesis_checks": { "type": "array", "items": { "type": "object" } }
      }
    },
    "meta": {
      "$ref": "notebook-overview.schema.json#/$defs/meta"
    }
  }
}
