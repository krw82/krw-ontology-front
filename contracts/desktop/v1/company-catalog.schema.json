{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krwontology.com/contracts/desktop/v1/company-catalog.schema.json",
  "title": "KRW Desktop Company Catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "contract_version", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "contract_version": { "const": "desktop-company-catalog/v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["companies"],
      "properties": {
        "companies": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/companySummary" }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_release_id",
        "generated_at",
        "query",
        "returned_count",
        "next_cursor",
        "has_more",
        "max_age_seconds"
      ],
      "properties": {
        "catalog_release_id": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "query": { "type": "string", "maxLength": 120 },
        "returned_count": { "type": "integer", "minimum": 0, "maximum": 50 },
        "next_cursor": { "type": ["string", "null"], "maxLength": 2000 },
        "has_more": { "type": "boolean" },
        "max_age_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    }
  },
  "$defs": {
    "companySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ticker",
        "name",
        "display_name",
        "localized_name",
        "sector",
        "description",
        "core_strength",
        "critical_risk",
        "latest_period",
        "document_count",
        "document_types",
        "coverage_label"
      ],
      "properties": {
        "ticker": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9.-]{0,15}$" },
        "name": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 },
        "localized_name": { "type": ["string", "null"] },
        "sector": { "type": ["string", "null"] },
        "description": { "type": "string" },
        "core_strength": { "type": ["string", "null"] },
        "critical_risk": { "type": ["string", "null"] },
        "latest_period": { "type": ["string", "null"] },
        "document_count": { "type": "integer", "minimum": 0 },
        "document_types": { "type": "array", "items": { "type": "string" } },
        "coverage_label": { "type": "string" }
      }
    }
  }
}
