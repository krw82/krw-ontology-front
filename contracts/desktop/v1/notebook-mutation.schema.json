{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krwontology.com/contracts/desktop/v1/notebook-mutation.schema.json",
  "title": "KRW Desktop Notebook Mutation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "contract_version", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "contract_version": { "const": "desktop-notebook-mutation/v1" },
    "data": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "mark": { "type": "object" },
        "note": { "type": "object" },
        "question": { "type": "object" }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "required": ["generated_at"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "replayed": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
