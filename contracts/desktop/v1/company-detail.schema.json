{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krwontology.com/contracts/desktop/v1/company-detail.schema.json",
  "title": "KRW Desktop Company Detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["ok", "contract_version", "data", "meta"],
  "properties": {
    "ok": { "const": true },
    "contract_version": { "const": "desktop-company-detail/v1" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company"],
      "properties": {
        "company": {
          "type": "object",
          "allOf": [
            {
              "$ref": "company-catalog.schema.json#/$defs/companySummaryShape"
            },
            {
              "type": "object",
              "required": ["periods", "documents", "generated_at"],
              "properties": {
                "periods": { "type": "array", "items": { "type": "string" } },
                "documents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "period",
                      "document_type",
                      "doc_type_key",
                      "generated_at"
                    ],
                    "properties": {
                      "period": { "type": "string" },
                      "document_type": { "type": "string" },
                      "doc_type_key": { "type": ["string", "null"] },
                      "generated_at": {
                        "type": ["string", "null"],
                        "format": "date-time"
                      }
                    }
                  }
                },
                "generated_at": {
                  "type": ["string", "null"],
                  "format": "date-time"
                }
              }
            }
          ],
          "unevaluatedProperties": false
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "catalog_release_id",
        "generated_at",
        "max_age_seconds"
      ],
      "properties": {
        "catalog_release_id": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "max_age_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    }
  }
}
