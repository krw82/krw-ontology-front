#!/bin/sh
set -eu

export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-/home/nextjs/.claude-prod}"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}"

case "${ANTHROPIC_API_KEY:-}" in
  ""|"sk-placeholder"|"sk-ant-..."|"sk-ant-…"|"<anthropic-api-key>")
    unset ANTHROPIC_API_KEY
    ;;
esac

case "${ANTHROPIC_AUTH_TOKEN:-}" in
  ""|"sk-placeholder"|"sk-ant-..."|"sk-ant-…"|"<anthropic-auth-token>")
    unset ANTHROPIC_AUTH_TOKEN
    ;;
esac

if [ -x /app/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl/claude ]; then
  exec /app/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl/claude "$@"
fi

if [ -x /app/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude ]; then
  exec /app/node_modules/@anthropic-ai/claude-agent-sdk-linux-x64/claude "$@"
fi

echo "claude-prod: Claude Code native binary was not found in node_modules/@anthropic-ai" >&2
exit 127
