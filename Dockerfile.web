# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim AS base

# Dependencies stage
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Build stage
FROM base AS builder
WORKDIR /app

ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_BRANDFETCH_CLIENT_ID
ARG NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=1
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY
ARG NEXT_PUBLIC_APP_VERSION
ARG GOOGLE_SITE_VERIFICATION
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=$NEXT_PUBLIC_BRANDFETCH_CLIENT_ID
ENV NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=$NEXT_PUBLIC_ENABLE_EMAIL_LOGIN
ENV NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY
ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION
ENV GOOGLE_SITE_VERIFICATION=$GOOGLE_SITE_VERIFICATION

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# Production stage
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PATH="/opt/krw-ontology-venv/bin:${PATH}"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/krw-ontology-venv \
    && /opt/krw-ontology-venv/bin/pip install --no-cache-dir 'markitdown[pdf]'

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
# The agent executor is Mac-only.  Copy only the stateless GCP support
# workers so the GCP image cannot run the ontology agent-worker as a sidecar.
COPY --from=builder --chown=nextjs:nodejs /app/.worker/document-worker.mjs ./.worker/document-worker.mjs
COPY --from=builder --chown=nextjs:nodejs /app/.worker/document-outbox-dispatcher.mjs ./.worker/document-outbox-dispatcher.mjs
COPY --from=builder --chown=nextjs:nodejs /app/.worker/filing-notification-worker.mjs ./.worker/filing-notification-worker.mjs
COPY --from=builder --chown=nextjs:nodejs /app/.worker/filing-brief-worker.mjs ./.worker/filing-brief-worker.mjs
COPY --from=builder --chown=nextjs:nodejs /app/.worker/filings-mcp-server.mjs ./.worker/filings-mcp-server.mjs
COPY --from=builder --chown=nextjs:nodejs /app/.worker/billing-worker.mjs ./.worker/billing-worker.mjs
COPY --from=builder --chown=nextjs:nodejs /app/.services ./.services
COPY --from=prod-deps --chown=nextjs:nodejs /app/node_modules ./node_modules
# Next standalone file tracing misses the Claude Agent SDK native optional
# package because the SDK resolves it dynamically at runtime.
COPY --from=deps --chown=nextjs:nodejs /app/node_modules/@anthropic-ai ./node_modules/@anthropic-ai
COPY --from=builder --chown=nextjs:nodejs /app/docker/claude-prod /usr/local/bin/claude-prod

RUN chmod 755 /usr/local/bin/claude-prod

RUN <<'EOF'
set -eu
mkdir -p .next/cache /app/agent-workspace /home/nextjs/.claude-prod /srv/krw-document-inbox
chown -R nextjs:nodejs .next /app/agent-workspace /home/nextjs/.claude-prod /srv/krw-document-inbox
EOF

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
