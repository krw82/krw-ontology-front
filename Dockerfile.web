# syntax=docker/dockerfile:1.7
FROM node:20-bookworm-slim AS base

# Dependencies stage
FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Build stage
FROM base AS builder
WORKDIR /app

ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG GOOGLE_SITE_VERIFICATION
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV GOOGLE_SITE_VERIFICATION=$GOOGLE_SITE_VERIFICATION

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# Production stage
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PATH="/opt/krw-ontology-venv/bin:${PATH}"

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    python3 \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY --from=krw-ontology-src pyproject.toml /tmp/krw-ontology/pyproject.toml
COPY --from=krw-ontology-src src /tmp/krw-ontology/src
COPY --from=krw-ontology-src ontology /tmp/krw-ontology/ontology
RUN python3 -m venv /opt/krw-ontology-venv \
    && /opt/krw-ontology-venv/bin/pip install --no-cache-dir /tmp/krw-ontology 'markitdown[pdf]' \
    && rm -rf /tmp/krw-ontology

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/.worker ./.worker
COPY --from=builder --chown=nextjs:nodejs /app/.services ./.services
COPY --from=prod-deps --chown=nextjs:nodejs /app/node_modules ./node_modules
# Next standalone file tracing misses the Claude Agent SDK native optional
# package because the SDK resolves it dynamically at runtime.
COPY --from=deps --chown=nextjs:nodejs /app/node_modules/@anthropic-ai ./node_modules/@anthropic-ai
COPY --from=krw-ontology-src --chown=nextjs:nodejs plugins/krw-ontology ./krw-ontology/plugins/krw-ontology
COPY --from=builder --chown=nextjs:nodejs /app/docker/claude-prod /usr/local/bin/claude-prod

RUN chmod 755 /usr/local/bin/claude-prod

RUN <<'EOF'
set -eu
cat > ./krw-ontology/plugins/krw-ontology/.mcp.json <<'JSON'
{
  "mcpServers": {
    "krw-ontology": {
      "command": "/opt/krw-ontology-venv/bin/krw-ontology-mcp",
      "args": [],
      "env": {
        "KRW_ONTOLOGY_ENV": "prod"
      }
    }
  }
}
JSON
chown nextjs:nodejs ./krw-ontology/plugins/krw-ontology/.mcp.json
mkdir -p .next/cache /app/agent-workspace /home/nextjs/.claude-prod /srv/krw-document-inbox
chown -R nextjs:nodejs .next /app/agent-workspace /home/nextjs/.claude-prod /srv/krw-document-inbox
EOF

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
