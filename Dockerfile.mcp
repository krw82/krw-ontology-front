# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

WORKDIR /app

# Runtime healthcheck dependency.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install the ontology Python package needed by the MCP runtime.
COPY --from=krw-ontology-src pyproject.toml /tmp/krw-ontology/pyproject.toml
COPY --from=krw-ontology-src src /tmp/krw-ontology/src
COPY --from=krw-ontology-src ontology /tmp/krw-ontology/ontology
RUN pip install --no-cache-dir /tmp/krw-ontology \
    && rm -rf /tmp/krw-ontology
COPY docker/mcp_http_entrypoint.py /app/mcp_http_entrypoint.py

# Create data directory
RUN mkdir -p /srv/krw-ontology-data

# Non-root user for security
RUN useradd -r -s /bin/false mcp

USER mcp
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD curl -sf http://localhost:8000/readyz || exit 1

ENTRYPOINT ["python", "/app/mcp_http_entrypoint.py"]
