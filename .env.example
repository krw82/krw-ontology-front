# ============================================================
# KRW Ontology Web Chat - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ---
# Browser-safe values used by Next.js client bundles.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=bf_client_id
# Public app origins used by auth redirects, absolute links, and deploy checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_REDIRECT_ORIGIN=http://localhost:3000
# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
# Server/container aliases. Keep these in sync with the NEXT_PUBLIC values.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Required on the server. Also used by DEV_AUTH_BYPASS=1 for local development
# no-login API/E2E flows; never expose this value to browser bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Optional for long-running Postgres LISTEN connections. If explicit LISTEN
# URLs are unset, remote Supabase LISTEN/NOTIFY derives direct Postgres URLs
# from this.
SUPABASE_DB_PASSWORD=
AGENT_QUEUE_LISTEN_DATABASE_URL=
AGENT_RUN_EVENT_LISTEN_DATABASE_URL=
AGENT_RUN_CANCEL_LISTEN_DATABASE_URL=
# Local Supabase Google OAuth provider. Keep the secret out of committed files.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- KRW Desktop Authorization Code + PKCE ---
DESKTOP_AUTH_CLIENT_ID=krw-desktop-macos
DESKTOP_AUTH_REDIRECT_URI=com.krw.desktop:/oauth/callback
DESKTOP_AUTHORIZATION_STARTS_PER_IP_PER_MINUTE=10
DESKTOP_AUTHORIZATION_EXCHANGES_PER_IP_PER_MINUTE=30

# --- KRW Desktop LLM Gateway / DeepSeek ---
# Shared only by the Web control plane and llm-gateway service. Generate at
# least 32 random bytes. Never expose it to Desktop or browser code.
KRW_LLM_JOB_TOKEN_SECRET=
# Public base URL returned to Claude Agent SDK. Caddy routes this prefix to the
# dedicated llm-gateway container.
DESKTOP_LLM_GATEWAY_BASE_URL=http://localhost/llm/anthropic
# Optional live preflight health URL for the dedicated llm-gateway process.
# Local dev default: http://127.0.0.1:8787/healthz
DESKTOP_LLM_GATEWAY_HEALTH_URL=
DESKTOP_LLM_GATEWAY_HEALTH_TIMEOUT_MS=5000
DESKTOP_LLM_MODEL_PROFILE=deepseek-v4-flash
# Keep a Claude-compatible SDK model name; the gateway replaces the upstream
# request model with DESKTOP_LLM_UPSTREAM_MODEL.
DESKTOP_LLM_SDK_MODEL=claude-sonnet-4-6
DESKTOP_LLM_UPSTREAM_MODEL=deepseek-v4-flash
DESKTOP_LLM_JOB_TOKEN_TTL_SECONDS=600
DESKTOP_LLM_JOB_MAX_REQUESTS=128
DESKTOP_LLM_JOB_MAX_BUDGET_USD=1
DESKTOP_LLM_MAX_INPUT_TOKENS=
DESKTOP_LLM_MAX_OUTPUT_TOKENS=
DEEPSEEK_API_KEY=
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
LLM_GATEWAY_MAX_BODY_BYTES=4194304

# --- Toss Payments Billing ---
# API individual integration keys for Toss auto-billing. Production deploys
# require live_* keys by default; use test_* keys only in development or with
# ALLOW_TOSS_TEST_KEYS=1 for staging-like verification.
TOSS_PAYMENTS_CLIENT_KEY=test_ck_...
TOSS_PAYMENTS_SECRET_KEY=test_sk_...
TOSS_PAYMENTS_API_BASE_URL=https://api.tosspayments.com
# Required by POST /api/billing/toss/renew-due. Configure an external scheduler
# to call the endpoint with Authorization: Bearer <BILLING_CRON_SECRET>.
BILLING_CRON_SECRET=
BILLING_WORKER_ID=gcp-billing-worker
BILLING_WORKER_RECONCILE_INTERVAL_MS=60000
BILLING_WORKER_REQUIRE_TOSS_PAYMENTS=1
BILLING_WORKER_ALLOW_TOSS_TEST_KEYS=0
BILLING_MUTATIONS_PER_USER_PER_MINUTE=5

# --- Claude Agent SDK / KRW Ontology Plugin ---
# GCP web reads only Supabase web catalog rows. Full release roots and SQLite
# paths are for local/dev or Mac worker processes.
KRW_ONTOLOGY_ENV=dev
KRW_ONTOLOGY_RELEASE_ROOT=~/krw-ontology-data/releases/dev/current
KRW_ONTOLOGY_ROOT=~/krw-ontology-data/releases/dev/current
KRW_ONTOLOGY_MANIFEST_PATH=~/krw-ontology-data/releases/dev/current/manifest.json
KRW_ONTOLOGY_GLOBAL_SPINE_PATH=~/krw-ontology-data/releases/dev/current/indexes/global_spine.sqlite
KRW_ONTOLOGY_SHARD_MANIFEST_PATH=~/krw-ontology-data/releases/dev/current/indexes/shard_manifest.json
KRW_ONTOLOGY_QUEUE_ROOT=~/krw-ontology-data-running
KRW_ONTOLOGY_PLUGIN_PATH=~/krw-ontology/plugins/krw-ontology
KRW_GURU_ADVISOR_PLUGIN_PATH=~/krw-ontology/plugins/krw-guru-advisor
KRW_GURU_DATA_ROOT=~/krw-ontology-guru-data
KRW_GURU_RELEASE_ROOT=~/krw-ontology-guru-data/releases/dev/current
# Desktop ontology API executor. auto uses MCP only when KRW_ONTOLOGY_MCP_URL
# is configured; catalog is a development fallback and does not expose full
# trace/chain/search behavior.
DESKTOP_ONTOLOGY_EXECUTOR=auto
KRW_ONTOLOGY_MCP_URL=http://127.0.0.1:8766/mcp
KRW_ONTOLOGY_MCP_HEALTH_URL=http://127.0.0.1:8766/health
KRW_ONTOLOGY_MCP_READY_URL=http://127.0.0.1:8766/readyz
DESKTOP_ONTOLOGY_MCP_CONNECT_TIMEOUT_MS=30000
DESKTOP_ONTOLOGY_MCP_TOOL_TIMEOUT_MS=30000
DESKTOP_ONTOLOGY_MCP_HEALTH_TIMEOUT_MS=5000
DESKTOP_ONTOLOGY_MAX_RESULT_BYTES=60000
# Optional override for Claude Code executable discovery in bundled/server builds.
CLAUDE_CODE_EXECUTABLE=
# Production Claude config directory mounted into the web container.
CLAUDE_PROD_CONFIG_DIR=/srv/claude-prod

# --- Versioning ---
# Git commit hash of the web app deployment
WEB_COMMIT=
# Git commit hash or branch of the krw-ontology package
KRW_ONTOLOGY_COMMIT=main

# --- Entitlements / Rate Limits ---
# Optional comma-separated emails that receive internal admin entitlement.
# Leave empty in production unless the deployment explicitly needs this bypass.
ADMIN_EMAILS=
ANALYSIS_CREDIT_ENFORCEMENT_MODE=enforced
GLOBAL_CONCURRENT_RUN_LIMIT=8
CHAT_RUNS_PER_USER_PER_MINUTE=5
CHAT_RUNS_PER_IP_PER_MINUTE=20
CHAT_RUNS_PER_SESSION_PER_MINUTE=8
DESKTOP_ONTOLOGY_TOOL_CALLS_PER_USER_PER_MINUTE=30
DESKTOP_ONTOLOGY_TOOL_CALLS_PER_DEVICE_PER_MINUTE=30
DESKTOP_ONTOLOGY_TOOL_CALLS_PER_USER_PER_DAY=500
DESKTOP_DEVICE_LOGIN_STARTS_PER_IP_PER_MINUTE=10
ANALYTICS_EVENTS_PER_IP_PER_MINUTE=60
ANALYTICS_EVENTS_PER_ANONYMOUS_ID_PER_MINUTE=120
# Header set by trusted ingress/Caddy with the real client IP. Browser-supplied
# proxy headers such as CF-Connecting-IP/X-Real-IP/X-Forwarded-For are ignored.
# In production this must be explicitly set by the deployment if the ingress
# overwrites the header before traffic reaches Next.js.
TRUSTED_CLIENT_IP_HEADER=

# --- Claude Model ---
CLAUDE_MODEL=sonnet
CLAUDE_AGENT_MAX_TURNS=40
AGENT_MAX_TOOL_CALLS=18
AGENT_MAX_TOOL_RESULT_CHARS=100000
YAHOO_FINANCE_MAX_CALLS=4
# Inline chart generation is disabled by default. Set to 1 only after the
# create_chart_v1/token persistence path is ready for production.
KRW_CHARTS_ENABLED=0
# Chart-series sidecar attachment is also disabled by default. It can be
# re-enabled independently after inline charts are ready again.
KRW_CHART_SERIES_ENABLED=0
# Optional. The no-tool KRW Ontology router runs by default before research.
# Set to "off" only for emergency fallback to company_research routing.
KRW_CHAT_ROUTER_MODE=
# Optional. Leave blank to use <frontend repo>/.agent-workspace.
CLAUDE_AGENT_CWD=
# Hard kill for a single agent run.
AGENT_RUN_HARD_TIMEOUT_MINUTES=10

# --- Concurrency ---
LEASE_TIMEOUT_MINUTES=5
LEASE_HEARTBEAT_INTERVAL_MS=60000
# Agent execution is event-driven: one supervisor listens for Postgres NOTIFY
# wakeups and uses this slow reconcile interval only as a missed-notification
# safety net.
AGENT_SUPERVISOR_ID=agent-supervisor-dev
AGENT_SUPERVISOR_CONCURRENCY=8
AGENT_QUEUE_LISTEN_ENABLED=1
AGENT_QUEUE_LISTEN_CHANNEL=agent_run_queued
AGENT_QUEUE_RECONCILE_INTERVAL_MS=60000
AGENT_QUEUE_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_RUN_EVENT_LISTEN_ENABLED=1
AGENT_RUN_EVENT_LISTEN_CHANNEL=agent_run_event
AGENT_RUN_EVENT_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_EVENT_RECONCILE_INTERVAL_MS=15000
AGENT_RUN_CANCEL_LISTEN_ENABLED=1
AGENT_RUN_CANCEL_LISTEN_CHANNEL=agent_run_cancel
AGENT_RUN_CANCEL_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_RUN_CANCEL_RECONCILE_INTERVAL_MS=10000
AGENT_EVENT_STREAM_MAX_MS=120000
AGENT_SUPERVISOR_SHUTDOWN_GRACE_MS=120000
FAST_RESEARCH_RESERVE_COST_USD=0.05
STANDARD_RESEARCH_RESERVE_COST_USD=0.15
DEEP_RESEARCH_RESERVE_COST_USD=0.5
# DeepSeek V4 Flash official pricing, per 1M tokens. These values are used for
# provider-cost estimates; user credits are computed from weighted tokens.
CACHE_HIT_INPUT_COST_PER_MILLION=0.0028
INPUT_COST_PER_MILLION=0.14
OUTPUT_COST_PER_MILLION=0.28

# --- Internal Operations ---
# Required for /api/healthz/deep and /internal/mcp-health.
INTERNAL_API_KEY=
# Optional. SEC EDGAR fair access requests expect a descriptive User-Agent.
SEC_USER_AGENT="KRW Ontology 13F Ingestion ops@example.com"
# Optional explicit Postgres URL for `npm run 13f`. If unset, the script falls
# back to SUPABASE_DB_URL, DATABASE_URL, POSTGRES_URL, LISTEN database URLs, or
# NEXT_PUBLIC_SUPABASE_URL/SUPABASE_URL + SUPABASE_DB_PASSWORD. If direct
# Postgres is unavailable, it can also write through SUPABASE_SERVICE_ROLE_KEY.
SEC_13F_DATABASE_URL=

# --- MCP Logging ---
MCP_HEALTH_TIMEOUT_MS=30000
MCP_LOG_LEVEL=INFO

# --- Caddy / TLS ---
# Domain name for automatic HTTPS (leave as "localhost" for local dev)
DOMAIN=localhost

# --- Local E2E / Dev ---
# Development-only. Lets `next dev` enter protected pages without Google login.
DEV_AUTH_BYPASS=0
# Playwright-only deterministic company catalog fixture. Requires local dev host
# and DEV_AUTH_BYPASS=1, so it must stay disabled outside E2E.
KRW_E2E_STATIC_CATALOG=0
