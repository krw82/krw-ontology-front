# ============================================================
# KRW Ontology Web Chat - Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================

# --- Anthropic API ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase ---
# Browser-safe values used by Next.js client bundles.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=bf_client_id
# Public app origins used by auth redirects, absolute links, and deploy checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_REDIRECT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ENABLE_EMAIL_LOGIN=1
# review applies the temporary Free/Standard/Pro menu split; off restores the previous all-features access.
PLAN_FEATURE_SPLIT_MODE=review
# Business information shown in the public payment-review footer. Keep these
# values identical to the registered business documents and do not invent
# placeholder values in production.
BUSINESS_NAME=테스트컴퍼니
BUSINESS_REPRESENTATIVE=홍길동
BUSINESS_REGISTRATION_NUMBER=000-00-00000
BUSINESS_ECOMMERCE_REGISTRATION_NUMBER=2025-테스트구-0000
# 실제 사업장 주소 확인 후 입력 (현재 전달값은 전화번호와 동일함)
BUSINESS_ADDRESS=서울시 테스트구 테스트로 1
BUSINESS_PHONE=01000000000
BUSINESS_EMAIL=business@example.com
BUSINESS_PRIVACY_OFFICER=홍길동
# Optional Google Search Console verification token.
GOOGLE_SITE_VERIFICATION=
# Server/container aliases. Keep these in sync with the NEXT_PUBLIC values.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
# Required on the server. Also used by DEV_AUTH_BYPASS=1 for local development
# no-login API/E2E flows; never expose this value to browser bundles.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Comma-separated editor accounts allowed to use the local-only
# /admin/editorial console and upload company-story series. The console and
# write APIs deliberately return 404 outside localhost development; keep this
# server-only and never expose it to clients.
PULSE_EDITORIAL_ADMIN_EMAILS=
# Optional for long-running Postgres LISTEN connections. If explicit LISTEN
# URLs are unset, remote Supabase LISTEN/NOTIFY derives direct Postgres URLs
# from this.
SUPABASE_DB_PASSWORD=
AGENT_QUEUE_LISTEN_DATABASE_URL=
AGENT_RUN_EVENT_LISTEN_DATABASE_URL=
AGENT_RUN_CANCEL_LISTEN_DATABASE_URL=
# Local Supabase Google OAuth provider. Keep the secret out of committed files.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- KRW Desktop Authorization Code + PKCE ---
DESKTOP_AUTH_CLIENT_ID=krw-desktop-macos
DESKTOP_AUTH_REDIRECT_URI=com.krw.desktop:/oauth/callback
DESKTOP_AUTHORIZATION_STARTS_PER_IP_PER_MINUTE=10
DESKTOP_AUTHORIZATION_EXCHANGES_PER_IP_PER_MINUTE=30

# --- KRW Desktop LLM Gateway / DeepSeek ---
# Shared only by the Web control plane and llm-gateway service. Generate at
# least 32 random bytes. Never expose it to Desktop or browser code.
KRW_LLM_JOB_TOKEN_SECRET=
# Public base URL used by the private DeepSeek-compatible LLM gateway. Caddy
# routes this prefix to the dedicated llm-gateway container.
DESKTOP_LLM_GATEWAY_BASE_URL=http://localhost/llm/anthropic
# Optional live preflight health URL for the dedicated llm-gateway process.
# Local dev default: http://127.0.0.1:8787/healthz
DESKTOP_LLM_GATEWAY_HEALTH_URL=
DESKTOP_LLM_GATEWAY_HEALTH_TIMEOUT_MS=5000
DESKTOP_LLM_MODEL_PROFILE=deepseek-v4-flash
# Keep a Claude-compatible SDK model name; the gateway replaces the upstream
# request model with DESKTOP_LLM_UPSTREAM_MODEL.
DESKTOP_LLM_SDK_MODEL=claude-sonnet-4-6
DESKTOP_LLM_UPSTREAM_MODEL=deepseek-v4-flash
DESKTOP_LLM_JOB_TOKEN_TTL_SECONDS=600
DESKTOP_LLM_JOB_MAX_REQUESTS=128
DESKTOP_LLM_JOB_MAX_BUDGET_USD=1
DESKTOP_LLM_MAX_INPUT_TOKENS=
DESKTOP_LLM_MAX_OUTPUT_TOKENS=
DEEPSEEK_API_KEY=
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# OpenAI-compatible endpoint used only by the private filing-brief route.
DEEPSEEK_OPENAI_BASE_URL=https://api.deepseek.com
LLM_GATEWAY_MAX_BODY_BYTES=4194304

# --- Toss Payments Billing ---
# API individual integration keys for Toss auto-billing. Production deploys
# require live_* keys by default; use test_* keys only in development or with
# ALLOW_TOSS_TEST_KEYS=1 for staging-like verification.
TOSS_PAYMENTS_CLIENT_KEY=test_ck_...
TOSS_PAYMENTS_SECRET_KEY=test_sk_...
TOSS_PAYMENTS_API_BASE_URL=https://api.tosspayments.com
# Required by POST /api/billing/toss/renew-due. Configure an external scheduler
# to call the endpoint with Authorization: Bearer <BILLING_CRON_SECRET>.
BILLING_CRON_SECRET=
BILLING_WORKER_ID=gcp-billing-worker
BILLING_WORKER_RECONCILE_INTERVAL_MS=60000
BILLING_WORKER_REQUIRE_TOSS_PAYMENTS=1
BILLING_WORKER_ALLOW_TOSS_TEST_KEYS=0
BILLING_MUTATIONS_PER_USER_PER_MINUTE=5
# Emergency V2-only billing circuit breaker. Set to 0 only while performing
# a controlled read-only cutover or incident response; it never enables a
# legacy checkout route.
BILLING_WRITES_ENABLED=1

# --- Document Ingestion Queue ---
# Production compose runs a persistent Redis service by default. Override either
# URL only when using an external Redis/Valkey instance.
# Optional dedicated DB for shared, non-personalized Pulse candidates. When
# empty, Pulse uses REDIS_QUEUE_URL or DOCUMENT_QUEUE_REDIS_URL as a fallback.
PULSE_REDIS_URL=
DOCUMENT_INGESTION_BACKEND=bullmq
DOCUMENT_WORKER_ID=gcp-document-worker
DOCUMENT_OUTBOX_DISPATCHER_ID=gcp-document-outbox-dispatcher
REDIS_QUEUE_URL=
DOCUMENT_QUEUE_REDIS_URL=redis://redis:6379/0
DOCUMENT_INGESTION_CONCURRENT_LIMIT=2
DOCUMENT_OUTBOX_DISPATCH_INTERVAL_MS=15000
DOCUMENT_OUTBOX_DISPATCH_BATCH_SIZE=25
DOCUMENT_WORKER_RECONCILE_INTERVAL_MS=5000

# --- PWA Web Push / SEC filing notifications ---
# SEC discovery populates the catalog-wide Pulse feed. It is independent of
# automatic answer generation and requires a descriptive SEC_USER_AGENT.
FILING_DETECTION_ENABLED=1
# Keep personal inbox and browser-push delivery separately controlled. Neither
# switch pauses enrichment of events already discovered by SEC polling.
FILING_NOTIFICATION_CREATION_ENABLED=0
FILING_PUSH_ENABLED=0
# The Mac-local Finnhub worker reads this same gate by default. Set to 1 only
# after the market-issue notification migration and end-to-end inbox test pass.
LOCAL_NEWS_NOTIFICATION_CREATION_ENABLED=0
FILING_NOTIFICATION_WORKER_ID=gcp-filing-notification-worker
FILING_WORKER_TICK_MS=15000
SEC_CIK_POLL_INTERVAL_MS=300000
SEC_FILING_POLL_BATCH_SIZE=10
FILING_NOTIFICATION_DELIVERY_BATCH_SIZE=25
FILING_NOTIFICATION_MAX_PUSH_ATTEMPTS=8
SEC_FILING_REQUEST_DELAY_MS=650
SEC_GLOBAL_MIN_REQUEST_INTERVAL_MS=150
SEC_GLOBAL_DISCOVERY_SOURCES_PER_CYCLE=2
SEC_GLOBAL_SCHEDULER_LEASE_SECONDS=300
SEC_GLOBAL_RECONCILIATION_BATCH_SIZE=10
SEC_GLOBAL_ENRICHMENT_BATCH_SIZE=10
SEC_GLOBAL_NOTIFICATION_BATCH_SIZE=25
SEC_GLOBAL_CATALOG_LOOKBACK_DAYS=90
SEC_GLOBAL_BASELINE_CLEANUP_BATCH_SIZE=500
FILING_TICKER_PUSH_BATCH_WINDOW_MS=600000
FILING_RETENTION_CLEANUP_INTERVAL_MS=86400000
FILING_WORKER_DEPLOYMENT_ID=gcp-compose-prod
FILING_WORKER_ENV=prod

# --- Source-grounded SEC filing briefs (DeepSeek V4 Flash) ---
# Disabled by default. When enabled, set FILING_BRIEF_GATEWAY_TOKEN to one
# long random secret; it is shared only by llm-gateway and filing-brief-worker.
# The worker stores validated Korean summaries/citations, never raw SEC bodies.
FILING_BRIEF_ENABLED=0
FILING_BRIEF_GATEWAY_TOKEN=
FILING_BRIEF_GATEWAY_URL=http://llm-gateway:8787
FILING_BRIEF_WORKER_ID=gcp-filing-brief-worker
FILING_BRIEF_WORKER_TICK_MS=5000
FILING_BRIEF_BATCH_SIZE=2
FILING_BRIEF_MAX_JOBS_PER_DAY=500
FILING_BRIEF_MAX_INPUT_CHARS=24000
FILING_BRIEF_MAX_DOCUMENT_BYTES=10485760
FILING_BRIEF_SEC_MIN_REQUEST_INTERVAL_MS=150
FILING_BRIEF_GATEWAY_TIMEOUT_MS=30000
FILING_BRIEF_MAX_OUTPUT_TOKENS=600
FILING_BRIEF_MODEL=deepseek-v4-flash
FILING_BRIEF_UPSTREAM_TIMEOUT_MS=30000
FILING_BRIEF_GATEWAY_MAX_BODY_BYTES=524288

# --- On-demand SEC filing MCP ---
# Source filing cards can open a chat that reads the verified SEC primary
# document only when the user asks. No SEC body is persisted. Keep this off
# until FILINGS_MCP_AUTH_TOKEN and a distinct
# FILINGS_MCP_PERSONAL_SIGNING_SECRET are set to long random secrets in the
# runtime environment, then set it to 1.
FILINGS_MCP_ENABLED=0
FILINGS_MCP_AUTH_TOKEN=
FILINGS_MCP_PORT=8785
FILINGS_MCP_PERSONAL_SIGNING_SECRET=
FILINGS_MCP_HOST=127.0.0.1
FILINGS_MCP_MAX_DOCUMENT_BYTES=10485760
FILINGS_MCP_MAX_DOCUMENT_CHARS=1500000
FILINGS_MCP_CACHE_TTL_MS=300000
FILINGS_MCP_CACHE_MAX_ENTRIES=16

# Research Pulse is a federated read model over existing filing/notebook data.
# It is always available. The optional source-level safety switches below do not
# hide the route or navigation, and omitted values default to enabled.
PULSE_RESURFACE_ENABLED=1
PULSE_LEARNING_ENABLED=1
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Rust Research Engine / KRW Ontology ---
# GCP web reads only Supabase web catalog rows. Full release roots and SQLite
# paths are for local/dev or Mac worker processes.
KRW_ONTOLOGY_ENV=dev
KRW_ONTOLOGY_RELEASE_ROOT=~/krw-ontology-data/releases/dev/current
KRW_ONTOLOGY_DATA_HOST_ROOT=~/krw-ontology-data
KRW_ONTOLOGY_ROOT=~/krw-ontology-data/releases/dev/current
KRW_ONTOLOGY_MANIFEST_PATH=~/krw-ontology-data/releases/dev/current/manifest.json
KRW_ONTOLOGY_GLOBAL_SPINE_PATH=~/krw-ontology-data/releases/dev/current/indexes/global_spine.sqlite
KRW_ONTOLOGY_SHARD_MANIFEST_PATH=~/krw-ontology-data/releases/dev/current/indexes/shard_manifest.json
KRW_ONTOLOGY_QUEUE_ROOT=~/krw-ontology-data-running
KRW_ONTOLOGY_PLUGIN_PATH=~/krw-ontology-front/ref/plugins/dev/krw-ontology
KRW_GURU_ADVISOR_PLUGIN_PATH=~/krw-ontology/plugins/krw-guru-advisor
KRW_GURU_DATA_ROOT=~/krw-ontology-guru-data
KRW_GURU_RELEASE_ROOT=~/krw-ontology-guru-data/releases/dev/current
# Enables the sealed, agent-generated Guru investigation brief in development.
GURU_AGENT_GENERATED_BRIEF_ENABLED=1
# Desktop research tools fail closed unless the HTTP MCP URL is configured.
# The lightweight catalog listing remains server-backed and does not execute
# ontology research queries.
DESKTOP_ONTOLOGY_EXECUTOR=mcp
KRW_ONTOLOGY_MCP_URL=http://127.0.0.1:8766/mcp
KRW_ONTOLOGY_MCP_HEALTH_URL=http://127.0.0.1:8766/health
KRW_ONTOLOGY_MCP_READY_URL=http://127.0.0.1:8766/readyz
DESKTOP_ONTOLOGY_MCP_CONNECT_TIMEOUT_MS=30000
DESKTOP_ONTOLOGY_MCP_TOOL_TIMEOUT_MS=30000
DESKTOP_ONTOLOGY_MCP_HEALTH_TIMEOUT_MS=5000
DESKTOP_ONTOLOGY_MAX_RESULT_BYTES=180000

# --- Versioning ---
# Git commit hash of the web app deployment
WEB_COMMIT=
# Git commit hash or branch of the krw-ontology package
KRW_ONTOLOGY_COMMIT=main

# --- Entitlements / Rate Limits ---
# Optional comma-separated emails that receive internal admin entitlement.
# Leave empty in production unless the deployment explicitly needs this bypass.
ADMIN_EMAILS=
ANALYSIS_CREDIT_ENFORCEMENT_MODE=enforced
GLOBAL_CONCURRENT_RUN_LIMIT=8
CHAT_RUNS_PER_USER_PER_MINUTE=5
CHAT_RUNS_PER_IP_PER_MINUTE=20
CHAT_RUNS_PER_SESSION_PER_MINUTE=8
DESKTOP_ONTOLOGY_TOOL_CALLS_PER_USER_PER_MINUTE=30
DESKTOP_ONTOLOGY_TOOL_CALLS_PER_DEVICE_PER_MINUTE=30
DESKTOP_ONTOLOGY_TOOL_CALLS_PER_USER_PER_DAY=500
DESKTOP_DEVICE_LOGIN_STARTS_PER_IP_PER_MINUTE=10
ANALYTICS_EVENTS_PER_IP_PER_MINUTE=60
ANALYTICS_EVENTS_PER_ANONYMOUS_ID_PER_MINUTE=120
NEXT_PUBLIC_ANALYTICS_PAGE_VIEW_SAMPLE_RATE=0.1
NEXT_PUBLIC_WEB_VITALS_SAMPLE_RATE=0.1
NEXT_PUBLIC_INTERACTION_METRICS_SAMPLE_RATE=0.1
NEXT_PUBLIC_APP_VERSION=
# Required in production. Caddy overwrites this header with the direct client
# address before forwarding to Next.js; browser-supplied proxy headers such as
# CF-Connecting-IP/X-Real-IP/X-Forwarded-For are never trusted.
TRUSTED_CLIENT_IP_HEADER=x-krw-client-ip

# --- Research engine limits ---
AGENT_MAX_TOOL_CALLS=18
AGENT_MAX_TOOL_RESULT_CHARS=100000
YAHOO_FINANCE_MAX_CALLS=4
# Keep off until the evidence-envelope canary is explicitly promoted. When on,
# the company-research and scenario-sensitivity runtimes validate facts,
# calculations, and inferences against returned ResearchState evidence before
# they publish prose.
RESEARCH_ANSWER_ENVELOPE_ENABLED=0
# Structured visualizations are compiler-owned artifacts. Set to "on" in an
# environment that should generate, persist, and render them; any other value
# keeps the path disabled. There is no shadow or legacy-chart compatibility mode.
# The Ontology router attaches compact metric-series sidecars whenever a
# financial-metric question needs them. It never stores raw filing bodies.
KRW_CHART_SERIES_ENABLED=0
# Optional. The no-tool KRW Ontology router runs by default before research.
# Set to "off" only for emergency fallback to company_research routing.
KRW_CHAT_ROUTER_MODE=

# --- Concurrency ---
# Agent execution is event-driven: one supervisor listens for Postgres NOTIFY
# wakeups and uses this slow reconcile interval only as a missed-notification
# safety net.
AGENT_SUPERVISOR_ID=agent-supervisor-dev
AGENT_SUPERVISOR_CONCURRENCY=8
AGENT_QUEUE_LISTEN_ENABLED=1
AGENT_QUEUE_LISTEN_CHANNEL=agent_run_queued
AGENT_QUEUE_RECONCILE_INTERVAL_MS=60000
AGENT_QUEUE_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_RUN_EVENT_LISTEN_ENABLED=1
AGENT_RUN_EVENT_LISTEN_CHANNEL=agent_run_event
AGENT_RUN_EVENT_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_EVENT_RECONCILE_INTERVAL_MS=15000
AGENT_RUN_CANCEL_LISTEN_ENABLED=1
AGENT_RUN_CANCEL_LISTEN_CHANNEL=agent_run_cancel
AGENT_RUN_CANCEL_LISTEN_RECONNECT_INTERVAL_MS=5000
AGENT_RUN_CANCEL_RECONCILE_INTERVAL_MS=10000
AGENT_EVENT_STREAM_MAX_MS=120000
AGENT_SUPERVISOR_SHUTDOWN_GRACE_MS=120000
FAST_RESEARCH_RESERVE_COST_USD=0.05
STANDARD_RESEARCH_RESERVE_COST_USD=0.15
DEEP_RESEARCH_RESERVE_COST_USD=0.5
# DeepSeek V4 Flash official pricing, per 1M tokens. These values are used for
# provider-cost estimates; user credits are computed from weighted tokens.
CACHE_HIT_INPUT_COST_PER_MILLION=0.0028
INPUT_COST_PER_MILLION=0.14
OUTPUT_COST_PER_MILLION=0.28

# --- Internal Operations ---
# Required for /api/healthz/deep and /internal/mcp-health.
INTERNAL_API_KEY=
# Optional. SEC EDGAR fair access requests expect a descriptive User-Agent.
SEC_USER_AGENT="KRW Ontology 13F Ingestion ops@example.com"
# Optional explicit Postgres URL for `npm run 13f`. If unset, the script falls
# back to SUPABASE_DB_URL, DATABASE_URL, POSTGRES_URL, LISTEN database URLs, or
# NEXT_PUBLIC_SUPABASE_URL/SUPABASE_URL + SUPABASE_DB_PASSWORD. If direct
# Postgres is unavailable, it can also write through SUPABASE_SERVICE_ROLE_KEY.
SEC_13F_DATABASE_URL=

# --- MCP Logging ---
MCP_HEALTH_TIMEOUT_MS=30000
MCP_LOG_LEVEL=INFO
# Optional immutable deployment pins. When set, MCP /readyz, worker admission,
# and deploy verification fail closed on any mismatch.
KRW_MCP_EXPECTED_CONTRACT_VERSION=krw-ontology-mcp/v2
KRW_MCP_EXPECTED_BUILD_ID=
KRW_MCP_EXPECTED_BACKEND_GIT_SHA=
KRW_MCP_EXPECTED_TOOL_SCHEMA_SHA256=
KRW_MCP_EXPECTED_BUILD_FINGERPRINT_SHA256=
KRW_MCP_EXPECTED_RELEASE_MANIFEST_SHA256=
KRW_MCP_EXPECTED_SERVICE_FINGERPRINT_SHA256=

# --- Market Issue / News ingestion (X + web/RSS + enrichment) ---
# Environment partition for market-issue data (dev/staging/prod).
MARKET_ISSUE_ENV=prod
# X API v2 App-only bearer token. Required for BOTH the poll worker and the
# filtered-stream worker. Must be pay-per-use or higher for search/recent and
# filtered-stream access (Free tier returns 403). Get one at developer.x.com.
MARKET_ISSUE_X_BEARER_TOKEN=
MARKET_ISSUE_X_API_BASE_URL=https://api.x.com
# Poll worker (legacy). Disabled by default; the stream worker is preferred.
# Set to 1/true to re-enable the 5-min search/recent poller.
MARKET_ISSUE_X_INGESTION_ENABLED=0
MARKET_ISSUE_X_MAX_POSTS_PER_SOURCE=20
# Override the default X source seeds (JSON array). Leave empty to use the
# built-in macro/commentary/policy set. Set to [] to disable X seeding entirely.
MARKET_ISSUE_X_SOURCES=
# Filtered-stream worker (recommended). Holds one long-lived push connection
# and bills only for delivered tweets. Requires a pay-per-use or higher token.
# Set to 1/true to enable.
MARKET_ISSUE_STREAM_ENABLED=0
MARKET_ISSUE_STREAM_WORKER_ID=gcp-market-issue-stream-worker
# Worker id and poll interval for the legacy poll worker.
MARKET_ISSUE_WORKER_ID=gcp-market-issue-worker
MARKET_ISSUE_INGESTION_INTERVAL_MS=300000
# LLM summarizer for turning X posts into Korean market-issue briefs.
# Use zai_coding for the built-in GLM path, or external for a custom endpoint.
MARKET_ISSUE_LLM_PROVIDER=external
MARKET_ISSUE_SUMMARIZER_URL=
MARKET_ISSUE_SUMMARIZER_TOKEN=
MARKET_ISSUE_ZAI_API_KEY=
MARKET_ISSUE_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
MARKET_ISSUE_ZAI_MODEL=glm-5.1
MARKET_ISSUE_ZAI_TIMEOUT_MS=120000
MARKET_ISSUE_ZAI_MAX_TOKENS=4096

# --- Valuation / FMP ---
# Financial Modeling Prep API key. Required for the valuation-refresh worker.
# Get one at site.financialmodelingprep.com. Without this, the worker stays
# disabled and company pages show no valuation card.
FMP_API_KEY=
# Worker id and poll interval for the valuation-refresh worker.
VALUATION_REFRESH_WORKER_ID=valuation-refresh-local
VALUATION_REFRESH_INTERVAL_MS=3600000
VALUATION_REFRESH_BATCH_SIZE=20
# Optional comma-separated list for a targeted backfill or local verification.
# Leave empty in the scheduled worker.
VALUATION_REFRESH_TICKERS=
# Optional Mac worker runtime settings.
VALUATION_REFRESH_LOG_DIR=
VALUATION_REFRESH_NICE=10
VALUATION_REFRESH_MAXFILES=4096

# --- Mac-local Finnhub news worker ---
# This worker is intentionally built and started separately from GCP web. The
# browser and web runtime never receive FINNHUB_API_KEY or LOCAL_NEWS_VAULT_KEY.
LOCAL_NEWS_ENABLED=false
LOCAL_NEWS_WORKER_ID=local-finnhub-news-worker
LOCAL_NEWS_INTERVAL_MS=900000
# Finnhub company-news targets are the active ontology catalog (not user data).
# 45 tickers every 15 minutes completes the 355-company catalog in about 2 hours.
LOCAL_NEWS_COVERAGE_BATCH_SIZE=45
# The public candidate window is exact source time, not Finnhub's date range.
LOCAL_NEWS_MAX_ARTICLES_PER_TICKER=4
LOCAL_NEWS_LOOKBACK_HOURS=3
# The current Finnhub key advertises a 60 RPM cap. Keep a safe 48 RPM cadence.
LOCAL_NEWS_FINNHUB_REQUEST_INTERVAL_MS=1250
LOCAL_NEWS_FINNHUB_TIMEOUT_MS=15000
# Required only on the local Mac. Generate with: openssl rand -hex 32
LOCAL_NEWS_VAULT_KEY=
LOCAL_NEWS_VAULT_PATH=
# review stores a private, non-public projection for a one-shot check. Set to
# publish only after validating output; no source/provider fields are written.
LOCAL_NEWS_PUBLISH_MODE=review
# A local key takes priority, then MARKET_ISSUE_ZAI_API_KEY and ZAI_API_KEY.
LOCAL_NEWS_ZAI_API_KEY=
LOCAL_NEWS_ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
LOCAL_NEWS_ZAI_MODEL=glm-5.1
LOCAL_NEWS_ZAI_TIMEOUT_MS=120000
LOCAL_NEWS_ZAI_MAX_TOKENS=2048

# --- Caddy / TLS ---
# --- Direct krw-agent cutover ---
# New chat rooms are Rust-owned. Existing rooms are closed by migration.
KRW_AGENT_BACKEND_MODE=rust
# One provider is active for a release. Change only during a bounded drain and
# restart; the descriptor/model registry remain the source of truth.
KRW_AGENT_PROVIDER=deepseek
KRW_AGENT_ADMISSION_MODE=open
# Used only when KRW_AGENT_ADMISSION_MODE=canary. This is a comma-separated
# server-side UUID allowlist for the dedicated production evidence account.
# An absent or malformed value admits nobody.
KRW_AGENT_CANARY_PRINCIPAL_IDS=
KRW_AGENT_TENANT_ID=
# On GCP this is a single public file copied by the deployer. The complete
# release, Rust binaries, AgentImages, and provider key stay on the local Mac.
KRW_AGENT_PUBLIC_DESCRIPTOR_HOST_PATH=/opt/krw-agent/public-release.json
KRW_AGENT_RELEASE_DESCRIPTOR_PATH=/run/krw-agent/public-release.json
KRW_AGENT_RELEASE_ARTIFACT_HASH=
KRW_AGENT_RELEASE_SET_HASH=
# Production local-Mac Rust releases set this to 1 through the deploy script.
# The Rust daemon itself writes this shared-DB receipt; no plugin worker is
# involved. GCP does not queue work when that receipt is stale.
KRW_AGENT_DAEMON_HEARTBEAT_REQUIRED=0
AGENT_V1_DATABASE_URL=
AGENT_V1_DATABASE_CA_PEM=
AGENT_V1_DATABASE_CA_FILE=
KRW_RUNTIME_ENVIRONMENT=dev
AGENT_V1_OUTBOX_DATABASE_URL=

# --- Caddy / TLS ---
# Domain name for automatic HTTPS (leave as "localhost" for local dev)
DOMAIN=localhost

# --- Local E2E / Dev ---
# Development-only. Lets `next dev` enter protected pages without Google login.
DEV_AUTH_BYPASS=0
# Playwright-only deterministic company catalog fixture. Requires local dev host
# and DEV_AUTH_BYPASS=1, so it must stay disabled outside E2E.
KRW_E2E_STATIC_CATALOG=0
