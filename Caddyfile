{$DOMAIN:localhost} {
    handle_path /llm/* {
        reverse_proxy llm-gateway:8787 {
            # Set (rather than append) the ingress-owned header. This replaces
            # any browser-supplied value before it reaches an upstream.
            header_up X-KRW-Client-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up -CF-Connecting-IP
            header_up -X-Real-IP
        }
    }

    # BILLING_READ_ONLY_GATE_INSERTION_POINT
    handle {
        reverse_proxy web:3000 {
            # Set (rather than append) the ingress-owned header. This replaces
            # any browser-supplied value before it reaches an upstream.
            header_up X-KRW-Client-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up -CF-Connecting-IP
            header_up -X-Real-IP
        }
    }

    encode zstd gzip

    log {
        output stdout
        format filter {
            # Toss returns one-time authorization values in the callback query.
            # Preserve the request path for observability, but never retain a
            # usable auth key/customer key/token in access logs.
            request>uri query {
                replace authKey REDACTED
                replace customerKey REDACTED
                replace callbackToken REDACTED
                replace state REDACTED
            }
        }
    }
}
